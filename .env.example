# ZTE H3601P Router Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.

ZTE_ROUTER_URL=
ZTE_USERNAME=
ZTE_PASSWORD=
ZTE_RSA_PUBLIC_KEY=
SENTINEL_DATABASE_PATH=data/sentinel.db
# Select exactly one backend. PostgreSQL is the production backend; SQLite is
# intended for local development and tests.
SENTINEL_STORAGE_BACKEND=sqlite
# Required when SENTINEL_STORAGE_BACKEND=postgresql. Keep credentials in .env.
SENTINEL_DATABASE_URL=
# Logical network boundary used to prevent address collisions across networks.
SENTINEL_NETWORK_SCOPE=default

# RSA public key for routers using RSA-based password encryption.
# Use literal \n for newlines (they will be converted automatically).
# ZTE_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----

# Optional notification providers
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_GUILD_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
